# --- Postgres (Neon recommended, free) ---
# Get one from https://neon.tech -> copy connection string
# Example: postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/fresher_job_finder?schema=public"

# --- Jobs: Adzuna (dynamic country per user) ---
# Get keys from https://developer.adzuna.com
# Leave empty to auto-fallback to no-key remote APIs (Remotive/Arbeitnow) + mock
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# --- AI resume tailoring: Claude (paid, best) and/or Gemini (FREE tier) ---
# Priority: Claude -> Gemini -> local fallback (works with neither key).
# Get a Claude key from https://console.anthropic.com (needs billing credit)
ANTHROPIC_API_KEY=""
# Optional: claude-sonnet-4-5, claude-haiku-4-5, claude-opus-4-1
CLAUDE_MODEL="claude-sonnet-4-5"
# Get a FREE Gemini key from https://aistudio.google.com (no billing needed,
# generous free tier — plenty for resume generation)
GEMINI_API_KEY=""
# Optional: any free-tier Flash model, e.g. gemini-2.0-flash
GEMINI_MODEL="gemini-2.0-flash"
